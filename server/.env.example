PORT=4000
# Render supplies PORT automatically; keep this for local development.
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@supermart.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
WHATSAPP_ACCESS_TOKEN=your_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ADMIN_PHONE_NUMBER=919549092686
WHATSAPP_API_VERSION=v21.0
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Prefer a local service-account JSON path during development.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service-account.json
# Render alternative: base64-encoded complete service-account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIRESTORE_DATABASE_ID=(default)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
