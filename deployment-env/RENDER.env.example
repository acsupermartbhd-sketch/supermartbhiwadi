# Render backend environment variables
# Enter these in Render Dashboard > Service > Environment.
# Do not upload this file as a real .env file.

NODE_ENV=production
CLIENT_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app
JWT_SECRET=generate-a-long-random-secret
ADMIN_EMAIL=your-admin-email
ADMIN_PASSWORD=your-strong-admin-password

# Recommended: complete Firebase service-account JSON encoded as Base64.
# Generate locally, then paste the output into Render only:
# [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")) | Set-Clipboard
FIREBASE_SERVICE_ACCOUNT_BASE64=paste-base64-service-account-json-here
FIRESTORE_DATABASE_ID=(default)

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Optional notifications
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE_NUMBER=919549092686
WHATSAPP_API_VERSION=v21.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
